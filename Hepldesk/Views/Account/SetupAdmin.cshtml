@model Hepldesk.Models.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Setup Admin";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Setup Admin - Helpdesk</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <div class="container min-vh-100 d-flex
        align-items-center justify-content-center py-4">

        <div class="card shadow-sm border-0"
             style="width: 100%; max-width: 500px;">

            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <h3 class="fw-bold">Buat Admin Pertama</h3>
                    <p class="text-muted">
                        Lengkapi formulir untuk membuat akun administrator.
                    </p>
                </div>

                <form asp-controller="Account"
                      asp-action="SetupAdmin"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All"
                         class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NamaLengkap"
                               class="form-label"></label>
                        <input asp-for="NamaLengkap"
                               class="form-control"
                               placeholder="Nama lengkap" />
                        <span asp-validation-for="NamaLengkap"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Username"
                               class="form-label"></label>
                        <input asp-for="Username"
                               class="form-control"
                               placeholder="Username" />
                        <span asp-validation-for="Username"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label"></label>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="nama@email.com" />
                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label"></label>
                        <input asp-for="Password"
                               class="form-control"
                               placeholder="Minimal 8 karakter" />
                        <span asp-validation-for="Password"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword"
                               class="form-label"></label>
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               placeholder="Ulangi password" />
                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100 py-2">
                        Buat Akun Admin
                    </button>

                    <p class="text-muted small mt-3 mb-0">
                        Halaman setup hanya tersedia selama belum ada
                        pengguna dan aplikasi berjalan dalam mode Development.
                    </p>

                </form>

            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>