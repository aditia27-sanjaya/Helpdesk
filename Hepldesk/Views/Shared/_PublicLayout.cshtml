
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Helpdesk</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                background-color: #f5f7fb;
                color: #263238;
            }

            .public-navbar {
                background: #253783;
            }

                .public-navbar .navbar-brand {
                    font-weight: 700;
                    letter-spacing: .3px;
                }

                .public-navbar .nav-link {
                    color: rgba(255, 255, 255, .85);
                }

                    .public-navbar .nav-link:hover {
                        color: #ffffff;
                    }

            main {
                flex: 1;
            }

            .public-footer {
                background: #ffffff;
                border-top: 1px solid #e5e7eb;
            }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark public-navbar shadow-sm">
        <div class="container">
            <a class="navbar-brand"
               asp-controller="Public"
               asp-action="Index">
                <i class="bi bi-headset me-2"></i>Helpdesk
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#publicNavbar"
                    aria-controls="publicNavbar"
                    aria-expanded="false"
                    aria-label="Buka navigasi">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="publicNavbar">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Public"
                           asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>
                            Beranda
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Public"
                           asp-action="Create">
                            <i class="bi bi-pencil-square me-1"></i>
                            Buat Pengaduan
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Public"
                           asp-action="Track">
                            <i class="bi bi-search me-1"></i>
                            Cek Status
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="public-footer py-3 mt-4">
        <div class="container text-center">
            <small class="text-muted">
                &copy; @DateTime.Now.Year Helpdesk. Layanan pengaduan dan bantuan.
            </small>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
